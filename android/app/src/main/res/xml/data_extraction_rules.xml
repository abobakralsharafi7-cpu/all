<?xml version="1.0" encoding="utf-8"?>
<!--
    منع استخراج بيانات التطبيق عبر النسخ الاحتياطي السحابي أو نقل الجهاز.
    البيانات المالية لا تخرج من الجهاز إلا عبر النسخة الاحتياطية اليدوية المشفّرة.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
        <exclude domain="file" />
    </device-transfer>
</data-extraction-rules>
