<?xml version="1.0" encoding="utf-8"?>
<!--
    التطبيق يعمل محليًا بالكامل: يُمنع أي اتصال غير مشفّر (HTTP)،
    ولا يُوثق بشهادات المستخدم المضافة يدويًا (حماية من اعتراض الاتصال).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="false">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
