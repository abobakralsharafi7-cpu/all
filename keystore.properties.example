# ============================================================
#  ملف مفاتيح التوقيع الخاص بك — Proof Daftar
#  انسخ هذا الملف باسم:  keystore.properties
#  وضعه في مجلد:  android/
#  ⚠️ لا ترفع الملف الحقيقي على Git إطلاقًا (مُستثنى في .gitignore)
# ============================================================

# مسار ملف المفتاح (نسبي لمجلد android/ أو مسار مطلق)
storeFile=../proof-daftar.keystore

# كلمة سر ملف المفتاح
storePassword=ضع_كلمة_السر_هنا

# اسم المفتاح (alias)
keyAlias=proofdaftar

# كلمة سر المفتاح
keyPassword=ضع_كلمة_السر_هنا


# ============================================================
#  كيف تنشئ مفتاح التوقيع الخاص بك (مرة واحدة فقط):
# ============================================================
#
#   keytool -genkey -v \
#     -keystore proof-daftar.keystore \
#     -alias proofdaftar \
#     -keyalg RSA -keysize 4096 -validity 10000
#
#  ⚠️⚠️ تحذير مهم جدًا ⚠️⚠️
#  احفظ ملف .keystore وكلمة سره في ثلاثة أماكن آمنة على الأقل.
#  فقدان هذا الملف = لن تستطيع رفع أي تحديث لتطبيقك على
#  Google Play إلى الأبد، وستُضطر لنشر تطبيق جديد من الصفر.
#
# ============================================================
#  للبناء عبر GitHub Actions، أضف هذه الأسرار في:
#  Settings → Secrets and variables → Actions
# ============================================================
#
#   KEYSTORE_BASE64    ←  ناتج:  base64 -w0 proof-daftar.keystore
#   KEYSTORE_PASSWORD  ←  كلمة سر الملف
#   KEY_ALIAS          ←  proofdaftar
#   KEY_PASSWORD       ←  كلمة سر المفتاح
#
